    "react": "19.2.7",
    "react-dom": "19.2.7",
    "lossless-json": "4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "22.19.15",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@umijs/max": "4.7.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components"
    }
