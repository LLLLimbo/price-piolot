{
  "name": "price-pilot-workbench",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "description": "Price Pilot · 跨境商品定价工作台",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
